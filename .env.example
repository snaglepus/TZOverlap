# Copy to .env to override defaults. Real environment variables win over .env,
# and CLI flags (--port, --host, --dir) win over both.

# Port for the dev/preview server. 0 picks a free port.
PORT=5173

# Interface to bind. Use 0.0.0.0 to expose on your LAN.
HOST=127.0.0.1

# Directory the server serves: "src" for development, "dist" to preview a build.
SERVE_DIR=src

# Output directory for `npm run build`.
BUILD_OUT_DIR=dist

{
  "name": "tz-overlap",
  "version": "0.1.0",
  "private": true,
  "description": "Client-side time zone overlap planner: aligned, colour-coded timelines for up to eight zones.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.js",
    "start": "node scripts/serve.js",
    "preview": "node scripts/build.js && node scripts/serve.js --dir dist",
    "setup:browsers": "playwright install --only-shell chromium",
    "lint": "eslint --max-warnings=0 .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/build.js",
    "test:unit": "node --test --test-reporter=spec \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test --test-reporter=spec \"tests/integration/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:perf": "node --test --test-reporter=spec \"tests/perf/**/*.test.js\" && playwright test -c playwright.perf.config.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:perf",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:unit && npm run test:integration && npm run build && npm run test:e2e && npm run test:perf"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  }
}
